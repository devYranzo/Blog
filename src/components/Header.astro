---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SITE_TITLE } from '../consts';
import { getTranslations, type Locale } from '../i18n';
import HeaderLink from './HeaderLink.astro';
import ThemeIcon from './ThemeIcon.astro';

const lang = (Astro.currentLocale ?? 'es') as Locale;
const t = getTranslations(lang);

const homeUrl = getRelativeLocaleUrl(lang);
const aboutUrl = 'https://www.enekoyranzo.dev/#aboutme';
---

<header>
	<div class="header-container">
		<nav>
			<h2>
				<a href={homeUrl}>{SITE_TITLE}</a>
			</h2>

			<div class="internal-links">
				<HeaderLink href={homeUrl}>
					{t.nav.home}
				</HeaderLink>

				<HeaderLink href={aboutUrl}>
					{t.nav.about}
				</HeaderLink>
			</div>

			<div class="social-links">
				<a
					href="https://github.com/devYranzo/Blog"
					target="_blank"
					rel="noopener noreferrer"
					class="github-link"
				>
					<span class="sr-only">Go to Blog GitHub repo</span>

					<svg
						viewBox="0 0 16 16"
						aria-hidden="true"
						width="32"
						height="32"
					>
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>

				<ThemeIcon />
			</div>
		</nav>
	</div>
</header>

<style>
	header {
		position: fixed;
		top: 1rem;
		left: 0;
		right: 0;
		z-index: 50;
		padding: 0 1rem;
	}

	.header-container {
		width: 100%;
		max-width: 1536px;
		margin: 0 auto;

		background: transparent;
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);


		border: 1px solid rgba(var(--gray), 25%);
		border-radius: 0.75rem;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;

		width: 100%;
		height: 5rem;
		padding: 0 0.75rem;
		box-sizing: border-box;
	}

	h2 {
		margin: 0;
		font-size: 1.25rem;
		white-space: nowrap;
	}

	h2 a {
		padding: 0;
		color: rgb(var(--black));
		text-decoration: none;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;

		font-size: 1.25rem;
		white-space: nowrap;
	}

	.internal-links :global(a) {
		position: relative;
		padding: 0.25rem 0.5rem;
		color: rgb(var(--black));
		text-decoration: none;
	}

	.internal-links :global(a)::before {
		position: absolute;
		right: 0.5rem;
		bottom: 0;
		left: 0.5rem;

		height: 2px;

		background: rgb(52, 211, 153);

		content: '';

		transform: scaleX(0);
		transform-origin: left;

		transition: transform 300ms ease;
	}

	.internal-links :global(a:hover)::before,
	.internal-links :global(a.active)::before {
		transform: scaleX(1);
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.social-links a {
		display: flex;
		align-items: center;
		padding: 0.25rem;
		color: rgb(var(--black));
		text-decoration: none;
	}

	.github-link svg {
		display: block;
		width: 32px;
		height: 32px;
	}

	@media (max-width: 720px) {
		header {
			padding: 0 0.5rem;
		}

		nav {
			height: 4.5rem;
		}

		.internal-links {
			font-size: 1rem;
		}

		.social-links {
			display: none;
		}

		h2 {
			font-size: 1rem;
		}
	}

	@media (max-width: 500px) {
		.internal-links {
			gap: 0;
		}

		.internal-links :global(a) {
			padding: 0.25rem;
		}

		h2 {
			font-size: 0.9rem;
		}
	}
</style>
