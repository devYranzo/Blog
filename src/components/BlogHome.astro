---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';

import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import CategoryFilter from './CategoryFilter.astro';
import CategoryIcon from './CategoryIcon.astro';
import LanguageFilter from './LanguageFilter.astro';

import FormattedDate from './FormattedDate.astro';
import { getCategory } from '../data/categories';
import { getTranslations } from '../i18n';

interface Props {
	lang: 'es' | 'en' | 'eu';
}

const { lang } = Astro.props;

const t = getTranslations(lang);

const posts = (await getCollection('blog'))
	.filter((post) => post.data.lang === lang)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [
	...new Set(posts.flatMap((post) => post.data.categories)),
].sort();

// SEO: Generate alternate links for each language version of the blog home page
const alternateLinks = [
	{
		lang: 'es',
		url: new URL('/es/', Astro.site).href,
	},
	{
		lang: 'en',
		url: new URL('/en/', Astro.site).href,
	},
	{
		lang: 'eu',
		url: new URL('/eu/', Astro.site).href,
	},
];
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} alternates={alternateLinks} />

		<style>
			main {
				width: 1200px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 8rem 0 5rem;
			}

			/* --------------------------------
			 * Language selector + filters
			 * -------------------------------- */

			.blog-controls {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1rem;
				flex-wrap: wrap;
			}

			.filtros {
				display: flex;
				align-items: center;
				gap: 1rem;
				flex-wrap: wrap;
			}

			.filter-form {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.1rem 0.5rem;
				font: inherit;
				color: rgb(var(--gray-dark));
				background: var(--background);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
			}

			/* Solo aplica si en el futuro se usa un <select> nativo dentro de .filter-form */
			.filter-form select {
				font: inherit;
				color: rgb(var(--gray-dark));
				background: var(--background);
				border: none;
				outline: none;
				cursor: pointer;
			}

			.filter-form > svg {
				width: 20px;
				height: 20px;
				fill: currentColor;
				flex-shrink: 0;
			}

			.search-input {
				width: 220px;
				font: inherit;
				color: rgb(var(--gray-dark));
				background: var(--background);
				border: none;
				outline: none;
			}

			/* --------------------------------
			 * Post grid
			 * -------------------------------- */

			.post-list {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 2rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.post-list li {
				min-width: 0;
			}

			/* --------------------------------
			 * Cards
			 * -------------------------------- */

			.post-card {
				display: flex;
				height: 100%;
				overflow: hidden;
				background: var(--background);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				box-shadow:
					0 2px 6px rgba(var(--gray), 8%),
					0 8px 20px rgba(var(--gray), 10%);
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease,
					border-color 0.2s ease;
			}

			.post-card:hover {
				transform: translateY(-4px);
				border-color: rgba(var(--gray), 35%);
				box-shadow: var(--box-shadow);
			}

			.post-card a {
				display: flex;
				width: 100%;
				color: inherit;
				text-decoration: none;
			}

			/* --------------------------------
			 * Featured card
			 * -------------------------------- */

			.post-list li:first-child {
				grid-column: 1 / -1;
			}

			.post-list li:first-child .post-card {
				min-height: 360px;
			}

			.post-list li:first-child .post-card a {
				align-items: stretch;
			}

			.post-list li:first-child .post-image {
				width: 52%;
				min-height: 360px;
			}

			.post-list li:first-child .post-content {
				width: 48%;
				justify-content: center;
				padding: 3rem;
			}

			.post-list li:first-child .post-title {
				font-size: 2.369rem;
			}

			/* --------------------------------
			 * Regular cards
			 * -------------------------------- */

			.post-list li:not(:first-child) .post-card {
				min-height: 260px;
			}

			.post-list li:not(:first-child) .post-image {
				width: 42%;
				min-height: 260px;
			}

			.post-list li:not(:first-child) .post-content {
				width: 58%;
				padding: 2rem;
			}

			/* --------------------------------
			 * Images
			 * -------------------------------- */

			.post-image {
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 1rem;
				background: rgb(var(--gray-light));
				overflow: hidden;
			}

			.post-image img {
				display: block;
				width: 100%;
				height: 100%;
				max-height: 330px;
				object-fit: contain;
				border-radius: 12px;
				filter: drop-shadow(5px 5px 5px var(--image-shadow));
				transition: transform 0.3s ease;
			}

			.post-card:hover .post-image img {
				transform: scale(1.03);
			}

			/* --------------------------------
			 * Card content
			 * -------------------------------- */

			.post-content {
				display: flex;
				flex-direction: column;
				justify-content: center;
				min-width: 0;
			}

			.post-title {
				margin: 0 0 0.75rem 0;
				color: rgb(var(--black));
				font-size: 1.563rem;
				line-height: 1.2;
			}

			.post-description {
				margin: 0 0 1.5rem 0;
				color: rgb(var(--gray-dark));
				font-size: 1rem;
				line-height: 1.6;
			}

			.post-date {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				margin: auto 0 0 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}

			.post-date svg {
				width: 18px;
				height: 18px;
				fill: currentColor;
				flex-shrink: 0;
			}

			.post-card:hover .post-title,
			.post-card:hover .post-date {
				color: rgb(var(--accent));
			}

			/* --------------------------------
			 * Categories
			 * -------------------------------- */

			.post-categories {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin: 0 0 1rem 0;
			}

			.post-category {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				padding: 0.25rem 0.55rem;
				border-radius: 999px;
				background: rgba(var(--category-color), 12%);
				color: rgb(var(--category-color));
				font-size: 0.75rem;
				font-weight: 600;
				line-height: 1.2;
			}

			.post-category-icon {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
			}

			.post-category-icon :global(svg) {
				display: block;
			}

			/* --------------------------------
			 * Estados vacíos (sin posts / sin resultados de búsqueda)
			 * -------------------------------- */

			.empty-state,
			.no-results {
				padding: 3rem 1rem;
				text-align: center;
				color: rgb(var(--gray));
			}

			/* --------------------------------
			 * Responsive
			 * -------------------------------- */

			@media (max-width: 900px) {
				.post-list {
					grid-template-columns: 1fr;
				}

				.post-list li:first-child {
					grid-column: auto;
				}

				.post-list li:first-child .post-card,
				.post-list li:not(:first-child) .post-card {
					min-height: 280px;
				}

				.post-list li:first-child .post-image,
				.post-list li:not(:first-child) .post-image {
					width: 45%;
					min-height: 280px;
				}

				.post-list li:first-child .post-content,
				.post-list li:not(:first-child) .post-content {
					width: 55%;
					padding: 2rem;
				}

				.post-list li:first-child .post-title {
					font-size: 2rem;
				}
			}

			@media (max-width: 600px) {
				main {
					max-width: calc(100% - 1em);
					padding: 6.5rem 0.5em 3rem;
				}

				.blog-controls {
					align-items: stretch;
					flex-direction: column;
					margin-bottom: 1.5rem;
				}

				.search-input {
					width: 100%;
				}

				.post-list {
					gap: 1rem;
				}

				.post-list li:first-child .post-card,
				.post-list li:not(:first-child) .post-card {
					min-height: 0;
				}

				.post-list li:first-child .post-card a,
				.post-list li:not(:first-child) .post-card a {
					flex-direction: column;
				}

				.post-list li:first-child .post-image,
				.post-list li:not(:first-child) .post-image {
					width: 100%;
					height: 240px;
					min-height: 240px;
				}

				.post-list li:first-child .post-content,
				.post-list li:not(:first-child) .post-content {
					width: auto;
					padding: 1.5rem;
				}

				.post-list li:first-child .post-title {
					font-size: 1.8rem;
				}

				.post-title {
					font-size: 1.4rem;
				}

				.post-description {
					font-size: 0.95rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<section>
				<div class="blog-controls">
					<div class="filtros">
						<div class="filter-form">
							<LanguageFilter currentLang={lang} label={t.blog.selectLanguage} />
						</div>

						<div class="filter-form">
							<CategoryFilter
								categoriesList={categories}
								label={t.blog.allCategories}
								allLabel={t.blog.allCategories}
								translations={t.blog.categories}
							/>
						</div>
					</div>

					<form class="filter-form" onsubmit="return false">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							fill="currentColor"
							viewBox="0 -960 960 960"
							aria-hidden="true"
						>
							<path d="M380-320q-109 0-184.5-75.5T120-580t75.5-184.5T380-840t184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28-28 11-28-11L532-372q-30 24-69 38t-83 14m0-80q75 0 127.5-52.5T560-580t-52.5-127.5T380-760t-127.5 52.5T200-580t52.5 127.5T380-400" />
						</svg>

						<input
							id="blog-search"
							class="search-input"
							type="search"
							placeholder={t.blog.search}
							aria-label={t.blog.search}
							autocomplete="off"
						/>
					</form>
				</div>

				{
					posts.length === 0 ? (
						<p class="empty-state">{t.blog.noPosts}</p>
					) : (
						<>
							<ul class="post-list" id="post-list">
								{posts.map((post) => (
									<li
										data-title={post.data.title.toLowerCase()}
										data-description={post.data.description.toLowerCase()}
										data-categories={post.data.categories.join(' ').toLowerCase()}
									>
										<article class="post-card">
											<a href={`/${post.data.lang}/${post.data.slug}/`}>
												<div class="post-image">
													{post.data.heroImage && (
														<Image width={960} src={post.data.heroImage} alt="" />
													)}
												</div>

												<div class="post-content">
													<h2 class="post-title">{post.data.title}</h2>
													<p class="post-description">{post.data.description}</p>

													{post.data.categories.length > 0 && (
														<div class="post-categories">
															{post.data.categories.map((category) => {
																const definition = getCategory(category);

																return (
																	<span
																		class="post-category"
																		style={`--category-color: ${definition.color}`}
																	>
																		<span class="post-category-icon">
																			<CategoryIcon icon={definition.icon} size={14} />
																		</span>
																		<span>
																			{t.blog.categories[
																				category as keyof typeof t.blog.categories
																			] ?? category}
																		</span>
																	</span>
																);
															})}
														</div>
													)}

													<p class="post-date">
														<svg
															xmlns="http://www.w3.org/2000/svg"
															viewBox="0 -960 960 960"
															aria-hidden="true"
														>
															<path d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-40q0-17 11.5-28.5T280-880t28.5 11.5T320-840v40h320v-40q0-17 11.5-28.5T680-880t28.5 11.5T720-840v40h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80zm0-80h560v-400H200zm0-480h560v-80H200zm0 0v-80z" />
														</svg>
														<FormattedDate date={post.data.pubDate} />
													</p>
												</div>
											</a>
										</article>
									</li>
								))}
							</ul>

							<p id="no-results" class="no-results" hidden>
								{t.blog.noResults}
							</p>
						</>
					)
				}
			</section>
		</main>

		<Footer />

		<script>
			const searchInput = document.querySelector('#blog-search');
			const categoryFilter = document.querySelector<HTMLElement>('[data-category-filter]');
			const postList = document.querySelector<HTMLElement>('#post-list');
			const noResults = document.querySelector<HTMLElement>('#no-results');

			if (
				!(searchInput instanceof HTMLInputElement) ||
				!categoryFilter ||
				!postList ||
				!noResults
			) {
				// Sin post-list (0 posts) no hay nada que filtrar.
			} else {
				const postItems = Array.from(postList.querySelectorAll<HTMLLIElement>(':scope > li'));

				let selectedCategory = '';

				const filterPosts = () => {
					const searchTerm = searchInput.value.trim().toLowerCase();
					let visiblePosts = 0;

					for (const post of postItems) {
						const title = post.dataset.title ?? '';
						const description = post.dataset.description ?? '';
						const categories = post.dataset.categories ?? '';

						const matchesSearch =
							searchTerm === '' ||
							title.includes(searchTerm) ||
							description.includes(searchTerm) ||
							categories.includes(searchTerm);

						const matchesCategory =
							selectedCategory === '' || categories.split(' ').includes(selectedCategory);

						const shouldShow = matchesSearch && matchesCategory;
						post.hidden = !shouldShow;

						if (shouldShow) visiblePosts++;
					}

					noResults.hidden = visiblePosts > 0;
				};

				searchInput.addEventListener('input', filterPosts);

				categoryFilter.addEventListener('category-change', (event) => {
					if (event instanceof CustomEvent && typeof event.detail?.value === 'string') {
						selectedCategory = event.detail.value;
						filterPosts();
					}
				});
			}
		</script>
	</body>
</html>
