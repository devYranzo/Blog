---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

		<style>
			main {
				width: 960px;
			}

			.language-selector {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 2rem;
			}

			.language-selector label {
				color: rgb(var(--gray-dark));
				font-weight: 700;
			}

			.language-selector select {
				padding: 0.35rem 0.5rem;
				font: inherit;
				color: rgb(var(--gray-dark));
				background: var(--background);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 4px;
			}

			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}

			ul li {
				width: calc(50% - 1rem);
			}

			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}

			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}

			ul li:first-child img {
				width: 100%;
				height: 480px;
				object-fit: contain;
			}

			ul li:first-child .title {
				font-size: 2.369rem;
			}

			ul li img {
				display: block;
				width: 100%;
				height: 300px;
				margin-bottom: 0.5rem;
				padding: 0.5rem;
				border-radius: 12px;
				object-fit: contain;
				filter: drop-shadow(5px 5px 5px var(--image-shadow));
			}

			ul li a {
				display: block;
			}

			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}

			.date {
				margin: 0;
				color: rgb(var(--gray));
			}

			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}

			ul a:hover img {
				box-shadow: var(--box-shadow);
			}

			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}

				ul li {
					width: 100%;
					text-align: center;
				}

				ul li:first-child {
					margin-bottom: 0;
				}

				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<section>
				<div class="language-selector">
					<label for="language">Idioma</label>

					<select id="language" aria-label="Seleccionar idioma">
						<option value="es">Español</option>
						<option value="en">English</option>
						<option value="eus">Euskara</option>
					</select>
				</div>

				<ul class="post-list">
					{
						posts.map((post) => (
							<li data-language={post.data.lang}>
								<a href={`/${post.data.lang}/${post.data.slug}/`}>
									{post.data.heroImage && (
										<Image
											width={960}
											src={post.data.heroImage}
											alt=""
										/>
									)}

									<h4 class="title">{post.data.title}</h4>

									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>

				<p class="empty-state" hidden>
					No hay artículos disponibles en este idioma.
				</p>
			</section>
		</main>

		<Footer />

		<script>
			const defaultLanguage = 'es';

			const languageSelector =
				document.querySelector<HTMLSelectElement>('#language');

			const posts =
				document.querySelectorAll<HTMLElement>('[data-language]');

			const emptyState =
				document.querySelector<HTMLElement>('.empty-state');

			const getUserLanguage = () => {
				const browserLanguage =
					navigator.language.toLowerCase().split('-')[0];

				if (browserLanguage === 'eu') return 'eus';

				if (browserLanguage === 'en' || browserLanguage === 'es') {
					return browserLanguage;
				}

				return defaultLanguage;
			};

			const filterPosts = (selectedLanguage: string | undefined) => {
				let visiblePosts = 0;

				posts.forEach((post) => {
					const isVisible =
						post.dataset.language === selectedLanguage;

					post.hidden = !isVisible;

					visiblePosts += isVisible ? 1 : 0;
				});

				if (emptyState) {
					emptyState.hidden = visiblePosts > 0;
				}
			};

			const initialLanguage = getUserLanguage();

			if (languageSelector) {
				languageSelector.value = initialLanguage;
			}

			filterPosts(initialLanguage);

			languageSelector?.addEventListener('change', () => {
				filterPosts(languageSelector.value);
			});
		</script>
	</body>
</html>
