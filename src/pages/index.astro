---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

		<style>
			main {
				width: 1200px;
				max-width: calc(100% - 2em);
			}

			/* --------------------------------
			 * Language selector
			 * -------------------------------- */

			.language-selector {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 2rem;
			}

			.language-selector label {
				color: rgb(var(--gray-dark));
				font-weight: 700;
			}

			.language-selector select {
				padding: 0.35rem 0.5rem;
				font: inherit;
				color: rgb(var(--gray-dark));
				background: var(--background);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 6px;
				cursor: pointer;
			}

			.language-selector select:focus {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
			}

			/* --------------------------------
			 * Post grid
			 * -------------------------------- */

			.post-list {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 2rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.post-list li {
				min-width: 0;
			}

			/* --------------------------------
			 * Cards
			 * -------------------------------- */

			.post-card {
				display: flex;
				height: 100%;
				overflow: hidden;
				background: var(--background);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 16px;
				box-shadow:
					0 2px 6px rgba(var(--gray), 8%),
					0 8px 20px rgba(var(--gray), 10%);
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease,
					border-color 0.2s ease;
			}

			.post-card:hover {
				transform: translateY(-4px);
				border-color: rgba(var(--gray), 35%);
				box-shadow: var(--box-shadow);
			}

			.post-card a {
				display: flex;
				width: 100%;
				color: inherit;
				text-decoration: none;
			}

			/* --------------------------------
			 * Featured card
			 * -------------------------------- */

			.post-list li:first-child {
				grid-column: 1 / -1;
			}

			.post-list li:first-child .post-card {
				min-height: 360px;
			}

			.post-list li:first-child .post-card a {
				align-items: stretch;
			}

			.post-list li:first-child .post-image {
				width: 52%;
				min-height: 360px;
			}

			.post-list li:first-child .post-content {
				width: 48%;
				justify-content: center;
				padding: 3rem;
			}

			.post-list li:first-child .post-title {
				font-size: 2.369rem;
			}

			/* --------------------------------
			 * Regular cards
			 * -------------------------------- */

			.post-list li:not(:first-child) .post-card {
				min-height: 260px;
			}

			.post-list li:not(:first-child) .post-image {
				width: 42%;
				min-height: 260px;
			}

			.post-list li:not(:first-child) .post-content {
				width: 58%;
				padding: 2rem;
			}

			/* --------------------------------
			 * Images
			 * -------------------------------- */

			.post-image {
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 1rem;
				background: rgb(var(--gray-light));
				overflow: hidden;
			}

			.post-image img {
				display: block;
				width: 100%;
				height: 100%;
				max-height: 330px;
				object-fit: contain;
				border-radius: 12px;
				filter: drop-shadow(5px 5px 5px var(--image-shadow));
				transition: transform 0.3s ease;
			}

			.post-card:hover .post-image img {
				transform: scale(1.03);
			}

			/* --------------------------------
			 * Card content
			 * -------------------------------- */

			.post-content {
				display: flex;
				flex-direction: column;
				justify-content: center;
				min-width: 0;
			}

			.post-title {
				margin: 0 0 0.75rem 0;
				color: rgb(var(--black));
				font-size: 1.563rem;
				line-height: 1.2;
			}

			.post-description {
				margin: 0 0 1.5rem 0;
				color: rgb(var(--gray-dark));
				font-size: 1rem;
				line-height: 1.6;
			}

			.post-date {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				margin: auto 0 0 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}

			.post-date svg {
				width: 18px;
				height: 18px;
				fill: currentColor;
				flex-shrink: 0;
			}

			.post-card:hover .post-title,
			.post-card:hover .post-date {
				color: rgb(var(--accent));
			}

			/* --------------------------------
			 * Empty state
			 * -------------------------------- */

			.empty-state {
				padding: 3rem 1rem;
				text-align: center;
				color: rgb(var(--gray));
			}

			/* --------------------------------
			 * Responsive
			 * -------------------------------- */

			@media (max-width: 900px) {
				.post-list {
					grid-template-columns: 1fr;
				}

				.post-list li:first-child {
					grid-column: auto;
				}

				.post-list li:first-child .post-card,
				.post-list li:not(:first-child) .post-card {
					min-height: 280px;
				}

				.post-list li:first-child .post-image,
				.post-list li:not(:first-child) .post-image {
					width: 45%;
					min-height: 280px;
				}

				.post-list li:first-child .post-content,
				.post-list li:not(:first-child) .post-content {
					width: 55%;
					padding: 2rem;
				}

				.post-list li:first-child .post-title {
					font-size: 2rem;
				}
			}

			@media (max-width: 600px) {
				main {
					max-width: calc(100% - 1em);
					padding: 1.5em 0.5em;
				}

				.language-selector {
					margin-bottom: 1.5rem;
				}

				.post-list {
					gap: 1rem;
				}

				.post-list li:first-child .post-card,
				.post-list li:not(:first-child) .post-card {
					min-height: 0;
				}

				.post-list li:first-child .post-card a,
				.post-list li:not(:first-child) .post-card a {
					flex-direction: column;
				}

				.post-list li:first-child .post-image,
				.post-list li:not(:first-child) .post-image {
					width: 100%;
					height: 240px;
					min-height: 240px;
				}

				.post-list li:first-child .post-content,
				.post-list li:not(:first-child) .post-content {
					width: auto;
					padding: 1.5rem;
				}

				.post-list li:first-child .post-title {
					font-size: 1.8rem;
				}

				.post-title {
					font-size: 1.4rem;
				}

				.post-description {
					font-size: 0.95rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<section>
				<div class="language-selector">
					<label for="language">Idioma</label>

					<select id="language" aria-label="Seleccionar idioma">
						<option value="es">Español</option>
						<option value="en">English</option>
						<option value="eu">Euskara</option>
					</select>
				</div>

				<ul class="post-list">
					{
						posts.map((post) => (
							<li data-language={post.data.lang}>
								<article class="post-card">
									<a href={`/${post.data.lang}/${post.data.slug}/`}>
										<div class="post-image">
											{post.data.heroImage && (
												<Image
													width={960}
													src={post.data.heroImage}
													alt=""
												/>
											)}
										</div>

										<div class="post-content">
											<h2 class="post-title">
												{post.data.title}
											</h2>

											<p class="post-description">
												{post.data.description}
											</p>

											<p class="post-date">
												<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-40q0-17 11.5-28.5T280-880t28.5 11.5T320-840v40h320v-40q0-17 11.5-28.5T680-880t28.5 11.5T720-840v40h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80zm0-80h560v-400H200zm0-480h560v-80H200zm0 0v-80z"/></svg>
												<FormattedDate
													date={post.data.pubDate}
												/>
											</p>
										</div>
									</a>
								</article>
							</li>
						))
					}
				</ul>

				<p class="empty-state" hidden>
					No hay artículos disponibles en este idioma.
				</p>
			</section>
		</main>

		<Footer />

		<script>
			const defaultLanguage = 'es';

			const languageSelector =
				document.querySelector<HTMLSelectElement>('#language');

			const posts =
				document.querySelectorAll<HTMLElement>('[data-language]');

			const emptyState =
				document.querySelector<HTMLElement>('.empty-state');

			const getUserLanguage = () => {
				const browserLanguage =
					navigator.language.toLowerCase().split('-')[0];

				if (browserLanguage === 'eu') {
					return 'eu';
				}

				if (browserLanguage === 'en' || browserLanguage === 'es') {
					return browserLanguage;
				}

				return defaultLanguage;
			};

			const filterPosts = (selectedLanguage: string | undefined) => {
				let visiblePosts = 0;

				posts.forEach((post) => {
					const isVisible =
						post.dataset.language === selectedLanguage;

					post.hidden = !isVisible;

					visiblePosts += isVisible ? 1 : 0;
				});

				if (emptyState) {
					emptyState.hidden = visiblePosts > 0;
				}
			};

			const initialLanguage = getUserLanguage();

			if (languageSelector) {
				languageSelector.value = initialLanguage;
			}

			filterPosts(initialLanguage);

			languageSelector?.addEventListener('change', () => {
				filterPosts(languageSelector.value);
			});
		</script>
	</body>
</html>
