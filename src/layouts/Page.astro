---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	lang: 'es' | 'en' | 'eu';
}

const { title, description, lang } = Astro.props;
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />

		<main>
			<article>
				<h1>{title}</h1>

				<div class="content">
					<slot />
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 4rem 0 5rem;
	}

	article {
		color: rgb(var(--gray-dark));
	}

	h1 {
		margin-bottom: 2.5rem;
		color: rgb(var(--black));
		font-size: 3rem;
		line-height: 1.15;
	}

	.content {
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.content :global(p) {
		margin-bottom: 1.5rem;
	}

	@media (max-width: 720px) {
		main {
			padding: 2.5rem 0 3rem;
		}

		h1 {
			font-size: 2.2rem;
		}
	}
</style>
