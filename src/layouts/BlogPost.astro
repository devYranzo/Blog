---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import LanguageFilter from '../components/LanguageFilter.astro';
import { getTranslations } from '../i18n';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	lang,
	translationKey,
} = Astro.props;

const t = getTranslations(lang);

const allPosts = await getCollection('blog');

const translations = allPosts.filter(
	(post) => post.data.translationKey === translationKey,
);

const translationUrls = {
	es: null as string | null,
	en: null as string | null,
	eu: null as string | null,
};

for (const post of translations) {
	translationUrls[post.data.lang] = getRelativeLocaleUrl(
		post.data.lang,
		post.data.slug,
	);
}
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} />

		<style>
			:global(html) {
				scroll-behavior: smooth;
				scroll-padding-top: 6rem;
			}

			/* --------------------------------
			 * Article layout
			 * -------------------------------- */

			main {
				width: 1000px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 8rem 0 5rem;
			}

			.filter-form {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.1rem 0.5rem;
				font: inherit;
				color: rgb(var(--gray-dark));
				background: var(--background);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
			}

			/* --------------------------------
			 * Article navigation
			 * -------------------------------- */

			.article-navigation {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1rem;
			}

			.back-to-home {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				color: rgb(var(--gray-dark));
				font-weight: 600;
				text-decoration: none;
			}

			.back-to-home:hover {
				color: var(--accent);
			}

			.back-to-home svg {
				width: 18px;
				height: 18px;
				fill: currentColor;
			}

			/* --------------------------------
			 * Hero card
			 * -------------------------------- */

			.article-header {
				overflow: hidden;
				background: var(--background);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 16px;
				box-shadow:
					0 2px 6px rgba(var(--gray), 8%),
					0 8px 20px rgba(var(--gray), 10%);
			}

			.hero-image {
				display: flex;
				align-items: center;
				justify-content: center;
				box-sizing: border-box;
				width: 100%;
				height: 420px;
				padding: 1.5rem;
				background: rgb(var(--gray-light));
				overflow: hidden;
			}

			.hero-image img {
				display: block;
				width: auto;
				max-width: 100%;
				height: auto;
				max-height: 100%;
				object-fit: contain;
				border-radius: 12px;
				filter: drop-shadow(5px 5px 5px var(--image-shadow));
			}

			/* --------------------------------
			 * Article header content
			 * -------------------------------- */

			.article-header-content {
				padding: 2.5rem 3rem 2.75rem;
				text-align: center;
			}

			.post-date {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.4rem;
				margin: 0 0 0.75rem;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}

			.post-date svg {
				width: 18px;
				height: 18px;
				fill: currentColor;
				flex-shrink: 0;
			}

			.article-title {
				margin: 0;
				color: rgb(var(--black));
				font-size: 3rem;
				line-height: 1.15;
			}

			.article-divider {
				width: 70px;
				height: 3px;
				margin: 1.75rem auto 0;
				background: var(--accent);
				border: 0;
				border-radius: 999px;
			}

			.last-updated-on {
				margin-top: 0.35rem;
				font-size: 0.85rem;
				font-style: italic;
			}

			/* --------------------------------
			 * Article content
			 * -------------------------------- */

			.article-content {
				width: 720px;
				max-width: 100%;
				margin: 3rem auto 0;
				color: rgb(var(--gray-dark));
			}

			.article-content :global(h2) {
				margin-top: 2.5rem;
			}

			.article-content :global(h3) {
				margin-top: 2rem;
			}

			.article-content :global(p) {
				margin-bottom: 1.5rem;
			}

			.article-content :global(ul),
			.article-content :global(ol) {
				margin-bottom: 1.5rem;
				padding-left: 1.5rem;
			}

			.article-content :global(li) {
				margin-bottom: 0.5rem;
			}

			/* --------------------------------
			 * Code
			 * -------------------------------- */

			.article-content :global(pre) {
				margin: 2rem 0;
				padding: 1.5rem;
				overflow-x: auto;
				background: rgb(var(--gray-light));
				border: 1px solid rgba(var(--gray), 15%);
				border-radius: 12px;
			}

			.article-content :global(code) {
				border-radius: 4px;
			}

			.article-content :global(pre code) {
				background: transparent;
			}

			/* --------------------------------
			 * Blockquotes
			 * -------------------------------- */

			.article-content :global(blockquote) {
				margin: 2rem 0;
				padding: 0.75rem 0 0.75rem 1.25rem;
				border-left: 4px solid var(--accent);
				background: rgb(var(--gray-light));
				border-radius: 0 8px 8px 0;
			}

			/* --------------------------------
			 * Images inside articles
			 * -------------------------------- */

			.article-content :global(img) {
				display: block;
				margin: 2rem auto;
				border-radius: 12px;
			}

			/* --------------------------------
			 * Links
			 * -------------------------------- */

			.article-content :global(a) {
				font-weight: 600;
			}

			/* --------------------------------
			 * Back to top
			 * -------------------------------- */

			.back-to-top {
				position: fixed;
				z-index: 30;
				right: 1.5rem;
				bottom: 1.5rem;
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.7rem 0.9rem;
				color: rgb(var(--gray-dark));
				font: inherit;
				font-size: 0.85rem;
				font-weight: 700;
				text-decoration: none;
				background: var(--background);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				box-shadow:
					0 2px 6px rgba(var(--gray), 12%),
					0 8px 20px rgba(var(--gray), 12%);
				backdrop-filter: blur(8px);
				transition:
					color 0.15s ease,
					transform 0.15s ease,
					box-shadow 0.15s ease;
			}

			.back-to-top:hover {
				color: var(--accent);
				transform: translateY(-2px);
				box-shadow:
					0 4px 10px rgba(var(--gray), 15%),
					0 12px 24px rgba(var(--gray), 15%);
			}

			.back-to-top svg {
				width: 18px;
				height: 18px;
				fill: currentColor;
				flex-shrink: 0;
			}

			/* --------------------------------
			 * Mobile
			 * -------------------------------- */

			@media (max-width: 720px) {
				main {
					max-width: calc(100% - 1em);
					padding: 1.5rem 0.5rem 3rem;
				}

				.hero-image {
					height: 300px;
					padding: 1rem;
				}

				.article-header-content {
					padding: 2rem 1.5rem 2.25rem;
				}

				.article-title {
					font-size: 2.2rem;
				}

				.article-content {
					margin-top: 2rem;
				}
			}

			@media (max-width: 600px) {
				.article-navigation {
					align-items: flex-start;
					flex-direction: column;
				}

				.hero-image {
					height: 230px;
				}

				.article-header-content {
					padding: 1.5rem 1rem 1.75rem;
				}

				.article-title {
					font-size: 1.8rem;
				}

				.post-date {
					font-size: 0.85rem;
				}

				.article-content :global(pre) {
					margin-left: -0.5rem;
					margin-right: -0.5rem;
					border-radius: 8px;
				}

				.back-to-top {
					right: 1rem;
					bottom: 1rem;
					padding: 0.7rem;
				}

				.back-to-top span {
					display: none;
				}
			}
		</style>
	</head>

	<body id="top">
		<Header />

		<main>
			<div class="article-navigation">
				<a href={getRelativeLocaleUrl(lang)} class="back-to-home">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 -960 960 960"
						aria-hidden="true"
					>
						<path d="m313-440 196 196q12 12 11.5 28T508-188q-12 11-28 11.5T452-188L188-452q-6-6-8.5-13t-2.5-15 2.5-15 8.5-13l264-264q11-11 27.5-11t28.5 11q12 12 12 28.5T508-715L313-520h447q17 0 28.5 11.5T800-480t-11.5 28.5T760-440z" />
					</svg>

					{t.blog.back}
				</a>
				<div class="filter-form">
					<LanguageFilter
						currentLang={lang}
						label={t.blog.selectLanguage}
						urls={translationUrls}
					/>
				</div>
			</div>

			<article>
				<header class="article-header">
					{
						heroImage && (
							<div class="hero-image">
								<Image
									width={1000}
									src={heroImage}
									alt=""
								/>
							</div>
						)
					}

					<div class="article-header-content">
						<div class="post-date">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								aria-hidden="true"
								viewBox="0 -960 960 960"
							>
								<path d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-40q0-17 11.5-28.5T280-880t28.5 11.5T320-840v40h320v-40q0-17 11.5-28.5T680-880t28.5 11.5T720-840v40h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80zm0-80h560v-400H200zm0-480h560v-80H200zm0 0v-80z" />
							</svg>

							<FormattedDate date={pubDate} />

							{
								updatedDate && (
									<span class="last-updated-on">
										· {t.blog.updated}{' '}
										<FormattedDate date={updatedDate} />
									</span>
								)
							}
						</div>

						<h1 class="article-title">{title}</h1>

						<hr class="article-divider" />
					</div>
				</header>

				<div class="article-content">
					<slot />
				</div>
			</article>
		</main>

		<a
			href="#top"
			class="back-to-top"
			aria-label={t.blog.backToTop}
			title={t.blog.backToTop}
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 -960 960 960"
				aria-hidden="true"
			>
				<path d="M480-520 280-320l-56-56 256-256 256 256-56 56-200-200zm0-240L280-560l-56-56 256-256 256 256-56 56-200-200z" />
			</svg>

			<span>{t.blog.backToTop}</span>
		</a>

		<Footer />
	</body>
</html>
